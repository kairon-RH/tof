    })

    local MovSection = Window:Section({ Title = "Movement" })
    local ItemSection = Window:Section({ Title = "Items" })
    local TeleSection = Window:Section({ Title = "Teleport" })
    local MiscSection = Window:Section({ Title = "Misc" })
