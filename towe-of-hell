    do
        local VisualTab = VisualSection:Tab({
            Title = "Visuals",
            Icon = "eye",
            IconColor = Purple,
            IconShape = "Square",
            Border = true,
        })

        local function ClearESP()
            if State.ESPFolder then
                State.ESPFolder:Destroy()
                State.ESPFolder = nil
            end
        end

        local function BuildESP()
            ClearESP()
            State.ESPFolder = Instance.new("Folder")
            State.ESPFolder.Name = "RivoESP"
            State.ESPFolder.Parent = Workspace

            local function MakeESPForPlayer(player)
                if player == LocalPlayer then return end
                local function UpdateESP()
                    if not State.ESP then return end
                    local char = player.Character
                    if not char then return end
                    local root = char:FindFirstChild("HumanoidRootPart")
                    if not root then return end

                    local existing = State.ESPFolder:FindFirstChild(player.Name)
                    if existing then existing:Destroy() end

                    local billboard = Instance.new("BillboardGui")
                    billboard.Name = player.Name
                    billboard.Size = UDim2.fromOffset(80, 20)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Adornee = root
                    billboard.Parent = State.ESPFolder

                    local nameLabel = Instance.new("TextLabel")
                    nameLabel.Size = UDim2.fromScale(1, 1)
                    nameLabel.BackgroundTransparency = 1
                    nameLabel.Font = Enum.Font.GothamBold
                    nameLabel.Text = player.Name
                    nameLabel.TextColor3 = Purple
                    nameLabel.TextStrokeTransparency = 0
                    nameLabel.TextSize = 13
                    nameLabel.Parent = billboard

                    local box = Instance.new("SelectionBox")
                    box.Name = player.Name .. "_Box"
                    box.Color3 = Purple
                    box.LineThickness = 0.04
                    box.SurfaceTransparency = 0.8
                    box.SurfaceColor3 = Color3.fromRGB(120, 80, 255)
                    box.Adornee = root
                    box.Parent = State.ESPFolder
                end

                player.CharacterAdded:Connect(function()
                    task.wait(0.5)
                    UpdateESP()
                end)
                UpdateESP()
            end

            for _, p in ipairs(Players:GetPlayers()) do
                MakeESPForPlayer(p)
            end

            Players.PlayerAdded:Connect(MakeESPForPlayer)
        end

        VisualTab:Toggle({
            Title = "ESP",
            Desc = "Show player boxes and names through walls",
            Value = false,
            Callback = function(v)
                State.ESP = v
                if v then
                    BuildESP()
                else
                    ClearESP()
                end
            end,
        })

        VisualTab:Space()

        VisualTab:Toggle({
            Title = "Kill Parts ESP",
            Desc = "Highlights kill bricks in red",
            Value = false,
            Callback = function(v)
                State.KillPartsESP = v
                if v then
                    if State.KillESPFolder then State.KillESPFolder:Destroy() end
                    State.KillESPFolder = Instance.new("Folder")
                    State.KillESPFolder.Name = "KillESP"
                    State.KillESPFolder.Parent = Workspace

                    local function TagKillParts(parent)
                        for _, obj in ipairs(parent:GetDescendants()) do
                            if obj:IsA("BasePart") then
                                local isKill = obj.Name:lower():find("kill")
                                    or obj.Name:lower():find("lava")
                                    or obj.Name:lower():find("death")
                                    or obj.Name:lower():find("acid")
                                    or obj.Name:lower():find("spike")
                                if isKill then
                                    local box = Instance.new("SelectionBox")
                                    box.Color3 = Red
                                    box.LineThickness = 0.05
                                    box.SurfaceTransparency = 0.6
                                    box.SurfaceColor3 = Color3.fromRGB(255, 50, 50)
                                    box.Adornee = obj
                                    box.Parent = State.KillESPFolder
                                end
                            end
                        end
                    end

                    TagKillParts(Workspace)
                    WindUI:Notify({ Title = "Rivo Hub", Content = "Kill parts highlighted.", Duration = 3 })
                else
                    if State.KillESPFolder then
                        State.KillESPFolder:Destroy()
                        State.KillESPFolder = nil
                    end
                end
            end,
        })

        VisualTab:Space()

        VisualTab:Toggle({
            Title = "Hide All",
            Desc = "Hides all parts in workspace locally",
            Value = false,
            Callback = function(v)
                State.HideAll = v
                for _, part in ipairs(Workspace:GetDescendants()) do
                    if part:IsA("BasePart") and not part:IsDescendantOf(Character) then
                        part.LocalTransparencyModifier = v and 1 or 0
                    end
                end
            end,
        })
    end

    do
        local OPTab = OPSection:Tab({
            Title = "OP",
            Icon = "shield",
            IconColor = Red,
            IconShape = "Square",
            Border = true,
        })

        OPTab:Toggle({
            Title = "Bypass Noclip",
            Desc = "Aggressive noclip — zero CanCollide on all character parts every frame",
            Value = false,
            Callback = function(v)
                State.BypassNoclip = v
                if v then
                    State.NoclipConn = RunService.Stepped:Connect(function()
                        if not State.BypassNoclip then return end
                        for _, part in ipairs(Character:GetDescendants()) do
                            if part:IsA("BasePart") then
                                part.CanCollide = false
                            end
                        end
                    end)
                else
                    if State.NoclipConn then State.NoclipConn:Disconnect() State.NoclipConn = nil end
                    for _, part in ipairs(Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = true
                        end
                    end
                end
            end,
        })

        OPTab:Space()

        OPTab:Toggle({
            Title = "God Mode",
            Desc = "Constantly resets health to max — does not bypass server kill parts",
            Value = false,
            Callback = function(v)
                State.GodMode = v
                if v then
                    State.GodConn = RunService.Heartbeat:Connect(function()
                        if not State.GodMode then return end
                        if Humanoid and Humanoid.Health < Humanoid.MaxHealth then
                            Humanoid.Health = Humanoid.MaxHealth
                        end
                    end)

                    Humanoid.Died:Connect(function()
                        if State.GodMode then
                            task.wait(0.1)
                            pcall(function()
                                Humanoid.Health = Humanoid.MaxHealth
                            end)
                        end
                    end)
                else
                    if State.GodConn then State.GodConn:Disconnect() State.GodConn = nil end
                end
            end,
        })
    end

    WindUI:Notify({
        Title = "Rivo Hub",
        Content = "Loaded successfully. Welcome.",
        Icon = "zap",
        Duration = 5,
    })
end

local function CheckKey()
    local entered = KeyBox.Text
    if entered == VALID_KEY then
        StatusLabel.TextColor3 = Green
        StatusLabel.Text = "Key valid. Loading..."
        task.wait(0.8)
        LaunchMainUI()
    else
        StatusLabel.TextColor3 = Red
        StatusLabel.Text = "Invalid key."
        TweenService:Create(Card, TweenInfo.new(0.05, Enum.EasingStyle.Bounce), {
            Position = UDim2.new(0.5, -6, 0.5, 0),
        }):Play()
        task.wait(0.05)
        TweenService:Create(Card, TweenInfo.new(0.05, Enum.EasingStyle.Bounce), {
            Position = UDim2.new(0.5, 6, 0.5, 0),
        }):Play()
        task.wait(0.05)
        TweenService:Create(Card, TweenInfo.new(0.08, Enum.EasingStyle.Bounce), {
            Position = UDim2.new(0.5, 0, 0.5, 0),
        }):Play()
    end
end

SubmitBtn.MouseButton1Click:Connect(CheckKey)

KeyBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        CheckKey()
    end
end)
