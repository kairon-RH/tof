    do
        local TeleTab = TeleSection:Tab({
            Title = "Teleport",
            Icon = "map-pin",
            IconColor = Pink,
            IconShape = "Square",
            Border = true,
        })

        local playerNames = {}
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= LocalPlayer then
                table.insert(playerNames, p.Name)
            end
        end

        local playerDropdown = TeleTab:Dropdown({
            Title = "Select Player",
            Values = playerNames,
            Value = playerNames[1],
            AllowNone = true,
            Callback = function() end,
        })

        TeleTab:Space()

        TeleTab:Button({
            Title = "Teleport to Player",
            Icon = "user",
            Color = Cyan,
            Justify = "Center",
            Callback = function()
                local sel = playerDropdown.Value
                if not sel then
                    WindUI:Notify({ Title = "Rivo Hub", Content = "Select a player first.", Duration = 3 })
                    return
                end
                local target = Players:FindFirstChild(sel)
                if target and target.Character then
                    local targetRoot = target.Character:FindFirstChild("HumanoidRootPart")
                    if targetRoot then
                        RootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 3, 0)
                    end
                end
            end,
        })

        TeleTab:Space()

        TeleTab:Button({
            Title = "Teleport to End",
            Desc = "Requires Fly to be active — may have bugs",
            Icon = "flag",
            Color = Green,
            Justify = "Center",
            Callback = function()
                if not State.Fly then
                    WindUI:Notify({ Title = "Rivo Hub", Content = "Enable Fly first for best results.", Duration = 4 })
                end
                local map = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("Tower") or Workspace:FindFirstChild("Towers")
                if map then
                    local highest = nil
                    local highestY = -math.huge
                    for _, part in ipairs(map:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if part.Position.Y > highestY then
                                highestY = part.Position.Y
                                highest = part
                            end
                        end
                    end
                    if highest then
                        RootPart.CFrame = highest.CFrame + Vector3.new(0, 5, 0)
                        WindUI:Notify({ Title = "Rivo Hub", Content = "Teleported to end of tower.", Duration = 3 })
                    else
                        WindUI:Notify({ Title = "Rivo Hub", Content = "Could not find tower end.", Duration = 3 })
                    end
                else
                    local highest = nil
                    local highestY = -math.huge
                    for _, part in ipairs(Workspace:GetDescendants()) do
                        if part:IsA("BasePart") and not part:IsDescendantOf(Character) then
                            if part.Position.Y > highestY then
                                highestY = part.Position.Y
                                highest = part
                            end
                        end
                    end
                    if highest then
                        RootPart.CFrame = CFrame.new(highest.Position + Vector3.new(0, 5, 0))
                        WindUI:Notify({ Title = "Rivo Hub", Content = "Teleported to highest point.", Duration = 3 })
                    end
                end
            end,
        })

        TeleTab:Space()

        TeleTab:Button({
            Title = "Teleport to Lobby",
            Desc = "Not working inside The Tower",
            Icon = "home",
            Color = Orange,
            Justify = "Center",
            Callback = function()
                local lobby = Workspace:FindFirstChild("Lobby")
                if lobby then
                    local spawnPart = lobby:FindFirstChildWhichIsA("BasePart")
