                        if not State.FusionActive then return end
                        RootPart.CFrame = RootPart.CFrame * CFrame.new(0, 0.1, 0)
                        task.wait()
                        RootPart.CFrame = RootPart.CFrame * CFrame.new(0, -0.1, 0)
                    end)
                else
                    if State.FusionConn then State.FusionConn:Disconnect() State.FusionConn = nil end
                end
            end,
        })
    end

    do
        local ItemsTab = ItemSection:Tab({
            Title = "Items",
            Icon = "package",
            IconColor = Orange,
            IconShape = "Square",
            Border = true,
        })

        local function GetTool(toolName)
            local backpack = LocalPlayer:FindFirstChild("Backpack")
            if not backpack then return nil end
            for _, v in ipairs(backpack:GetChildren()) do
                if v.Name:lower():find(toolName:lower()) then return v end
            end
            for _, v in ipairs(Character:GetChildren()) do
                if v:IsA("Tool") and v.Name:lower():find(toolName:lower()) then return v end
            end
            return nil
        end

        local function EquipTool(tool)
            if tool then
                local hum = Humanoid
                if hum then hum:EquipTool(tool) end
            end
        end

        local function UseTool()
            local equipped = Character:FindFirstChildWhichIsA("Tool")
            if equipped then
                local event = equipped:FindFirstChild("RemoteEvent") or equipped:FindFirstChild("RemoteFunction")
                if event then
                    if event:IsA("RemoteEvent") then
                        event:FireServer()
                    end
                end
                local activate = equipped:FindFirstChild("Activate")
                if activate then activate:Fire() end
                if equipped.Activated then
                    equipped.Activated:Fire()
                end
            end
        end

        ItemsTab:Button({
            Title = "Trowel",
            Desc = "Equip and use Trowel",
            Icon = "hammer",
            Color = Orange,
            Justify = "Center",
            Callback = function()
                local tool = GetTool("Trowel")
                if tool then
                    EquipTool(tool)
                    task.wait(0.2)
                    UseTool()
                else
                    WindUI:Notify({ Title = "Rivo Hub", Content = "Trowel not found in backpack.", Duration = 3 })
                end
            end,
        })

